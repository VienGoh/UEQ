generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.db"
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Platform {
  id        Int         @id @default(autoincrement())
  name      String      @unique // Shopee / TikTok Shop
  responden Responden[]
}

model Responden {
  id           Int      @id @default(autoincrement())
  nama         String
  umur         Int
  jenisKelamin String
  platformId   Int
  platform     Platform @relation(fields: [platformId], references: [id])
  createdAt    DateTime @default(now())

  taskResults TaskResult[]
  susAnswers  SUSAnswer[]
  ueqAnswers  UEQAnswer[] // <--- TAMBAHKAN BARIS INI

  @@unique([platformId, id])
}

model Task {
  id        Int      @id @default(autoincrement())
  namaTask  String
  deskripsi String
  createdAt DateTime @default(now())

  taskResults TaskResult[]
}

// schema.prisma - ubah field success menjadi nullable
model TaskResult {
  id          Int      @id @default(autoincrement())
  respondenId Int
  taskId      Int
  success     Boolean? // TAMBAHKAN ? untuk nullable
  timeOnTask  Float // dalam detik
  errorCount  Int // jumlah error
  createdAt   DateTime @default(now())

  responden Responden @relation(fields: [respondenId], references: [id])
  task      Task      @relation(fields: [taskId], references: [id])

  @@unique([respondenId, taskId])
}

model SUSQuestion {
  id         Int     @id @default(autoincrement())
  question   String
  isPositive Boolean // untuk perhitungan SUS

  answers SUSAnswer[]
}

model SUSAnswer {
  id          Int @id @default(autoincrement())
  respondenId Int
  questionId  Int
  score       Int // 1–5

  responden Responden   @relation(fields: [respondenId], references: [id])
  question  SUSQuestion @relation(fields: [questionId], references: [id])

  @@unique([respondenId, questionId]) // Mencegah duplikat jawaban untuk pertanyaan yang sama
}

model UEQQuestion {
  id             Int         @id @default(autoincrement())
  category       String // Attractiveness, Perspicuity, etc.
  leftAdjective  String
  rightAdjective String
  answers        UEQAnswer[]

  @@unique([category, leftAdjective, rightAdjective]) // optional
}

model UEQAnswer {
  id          Int @id @default(autoincrement())
  respondenId Int
  questionId  Int
  score       Int // -3 to 3

  responden Responden   @relation(fields: [respondenId], references: [id])
  question  UEQQuestion @relation(fields: [questionId], references: [id])

  @@unique([respondenId, questionId])
}
